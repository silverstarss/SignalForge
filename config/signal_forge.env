# Local path configuration for Signal Forge.
#
# Override these variables from the shell when moving machines. Scripts load
# this file first, then keep any values already exported by the caller.

SIGNAL_FORGE_ROOT=${SIGNAL_FORGE_ROOT:-/root/autodl-tmp/signal_forge}
SIGNAL_FORGE_ARTIFACT_ROOT=${SIGNAL_FORGE_ARTIFACT_ROOT:-/root/autodl-tmp/signal_forge_artifacts}

MODEL_ROOT=${MODEL_ROOT:-${SIGNAL_FORGE_ARTIFACT_ROOT}/models}
CHECKPOINT_ROOT=${CHECKPOINT_ROOT:-${SIGNAL_FORGE_ARTIFACT_ROOT}/checkpoints}
OUTPUT_ROOT=${OUTPUT_ROOT:-${SIGNAL_FORGE_ARTIFACT_ROOT}/outputs}
WANDB_ROOT=${WANDB_ROOT:-${SIGNAL_FORGE_ARTIFACT_ROOT}/wandb}
WHEEL_ROOT=${WHEEL_ROOT:-${SIGNAL_FORGE_ARTIFACT_ROOT}/wheels}
DATA_ROOT=${DATA_ROOT:-${SIGNAL_FORGE_ROOT}/data}

# Use 0.5B while stabilizing the pipeline. Override with 1.5B when ready.
QWEN25_DEFAULT_SIZE=${QWEN25_DEFAULT_SIZE:-0.5B}

# Optional exact local wheel. If unset, scripts select the first flash-attn
# wheel found in WHEEL_ROOT.
FLASH_ATTN_WHEEL=${FLASH_ATTN_WHEEL:-}

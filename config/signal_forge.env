# Runtime path configuration for Signal Forge.
#
# Scripts source this file after honoring variables already exported by the
# caller. Defaults are intentionally relative to the checked-out repository so
# the same code can move between machines without editing launch scripts.

if [ -z "${SIGNAL_FORGE_ROOT:-}" ]; then
    SIGNAL_FORGE_CONFIG_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
    export SIGNAL_FORGE_ROOT=$(cd -- "${SIGNAL_FORGE_CONFIG_DIR}/.." && pwd)
fi

export SIGNAL_FORGE_ENV_NAME=${SIGNAL_FORGE_ENV_NAME:-rtx6000d}
export SIGNAL_FORGE_ARTIFACT_ROOT=${SIGNAL_FORGE_ARTIFACT_ROOT:-${SIGNAL_FORGE_ROOT}/artifacts}

# Machine-local storage. Override from the shell if a larger mounted disk is
# available; do not hard-code host-specific paths in experiment scripts.
export MODEL_ROOT=${MODEL_ROOT:-${SIGNAL_FORGE_ARTIFACT_ROOT}/models}
export DATA_ROOT=${DATA_ROOT:-${SIGNAL_FORGE_ROOT}/data}
export CACHE_ROOT=${CACHE_ROOT:-${SIGNAL_FORGE_ARTIFACT_ROOT}/cache}
export CHECKPOINT_ROOT=${CHECKPOINT_ROOT:-${SIGNAL_FORGE_ARTIFACT_ROOT}/checkpoints}
export OUTPUT_ROOT=${OUTPUT_ROOT:-${SIGNAL_FORGE_ARTIFACT_ROOT}/outputs}
export WHEEL_ROOT=${WHEEL_ROOT:-${SIGNAL_FORGE_ARTIFACT_ROOT}/wheels}

# Hugging Face / library caches. First run may download; later runs reuse cache.
export HF_HOME=${HF_HOME:-${CACHE_ROOT}/huggingface}
export HF_HUB_CACHE=${HF_HUB_CACHE:-${HF_HOME}/hub}
export HF_DATASETS_CACHE=${HF_DATASETS_CACHE:-${HF_HOME}/datasets}
export TRANSFORMERS_CACHE=${TRANSFORMERS_CACHE:-${HF_HOME}/transformers}
export TORCH_HOME=${TORCH_HOME:-${CACHE_ROOT}/torch}
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-${CACHE_ROOT}/xdg}

# W&B is opt-in for migration smoke runs. Set ENABLE_WANDB=1 and WANDB_MODE=online
# when credentials are configured. Offline mode still writes under WANDB_ROOT.
export WANDB_ROOT=${WANDB_ROOT:-${SIGNAL_FORGE_ARTIFACT_ROOT}/wandb}
export WANDB_DIR=${WANDB_DIR:-${WANDB_ROOT}}
export WANDB_CACHE_DIR=${WANDB_CACHE_DIR:-${CACHE_ROOT}/wandb}
export WANDB_PROJECT=${WANDB_PROJECT:-signal_forge}
export WANDB_MODE=${WANDB_MODE:-offline}
export ENABLE_WANDB=${ENABLE_WANDB:-0}

# No-GPU boot is normal on the migrated machine before opening a GPU instance.
# Training still fails if CUDA is unavailable; this only relaxes preflight.
export ALLOW_NO_GPU_BOOT=${ALLOW_NO_GPU_BOOT:-1}
export REQUIRE_GPU_FOR_PREFLIGHT=${REQUIRE_GPU_FOR_PREFLIGHT:-0}
export NGPUS_PER_NODE=${NGPUS_PER_NODE:-1}
export NNODES=${NNODES:-1}

# Current migration scope: Qwen2.5-1.5B for compatibility smoke; Qwen2.5-3B for upcoming memory smoke.
export QWEN25_DEFAULT_SIZE=${QWEN25_DEFAULT_SIZE:-1.5B}
export QWEN25_1P5B_REPO_ID=${QWEN25_1P5B_REPO_ID:-Qwen/Qwen2.5-1.5B-Instruct}
export QWEN25_3B_REPO_ID=${QWEN25_3B_REPO_ID:-Qwen/Qwen2.5-3B-Instruct}
export ALLOW_HF_MODEL_DOWNLOAD=${ALLOW_HF_MODEL_DOWNLOAD:-1}

# Optional extra site-packages path. Leave unset by default so incomplete vendored packages do not shadow the active conda/runtime environment.
export VENDOR_PYTHON=${VENDOR_PYTHON:-}

# Optional exact local wheel. If unset, scripts select the first flash-attn
# wheel found in WHEEL_ROOT.
export FLASH_ATTN_WHEEL=${FLASH_ATTN_WHEEL:-}
